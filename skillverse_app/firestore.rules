rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      // Users can only read and write their own document.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    // Prevent clients from tampering with counters that
                    // should only ever be changed by trusted server logic
                    // (Cloud Functions) once those features ship.
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // ---------------- posts ----------------
    // authorName/authorLevel are denormalized onto the post document
    // itself at publish time, so the feed never needs to read another
    // user's /users/{uid} doc (which stays owner-only, above).
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() <= 1000;
      // Anyone signed in may update ONLY likeCount (the toggleLike
      // transaction touches this field on posts that aren't theirs);
      // every other field may only be changed by the post's author.
      allow update: if request.auth != null && (
                      (request.auth.uid == resource.data.authorId) ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']))
                    );
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // ---------------- comments ----------------
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 500;
      // Editing: only the comment's own author, and only the
      // text/editedAt fields (can't reassign authorship or postId).
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.authorId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // ---------------- likes ----------------
    // Doc id is "{postId}_{uid}" so a user can only ever hold one
    // like doc per post, and can only touch their own.
    match /likes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && likeId == request.resource.data.postId + '_' + request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if false; // likes are create/delete only, never edited
    }

    // ---------------- saves ----------------
    match /saves/{saveId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && saveId == request.resource.data.postId + '_' + request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if false;
    }

    // ---------------- not yet migrated — locked down ----------------
    // These collections are named in the product spec but the app
    // still reads/writes them locally (mock data), so there is no
    // client-side validation to trust yet. Read-only for now; open
    // write rules as each one gets its own Firestore migration pass.
    // ---------------- videos ----------------
    // Write-only from the client's perspective right now: publishing
    // a video records its Storage URL + metadata here
    // (FirestoreVideoService.recordPublishedVideo), but the Videos
    // tab itself still reads its feed locally — see
    // docs/FIRESTORE_POSTS_MIGRATION.md. Update/delete stay closed
    // until likes/comments/saves for videos get their own migration
    // pass, same reasoning as `posts` before that happened.
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }
    match /competitions/{id} { allow read: if request.auth != null; allow write: if false; }
    match /missions/{id} { allow read: if request.auth != null; allow write: if false; }
    match /badges/{id} { allow read: if request.auth != null; allow write: if false; }
    match /leaderboard/{id} { allow read: if request.auth != null; allow write: if false; }
    match /notifications/{id} { allow read: if request.auth != null; allow write: if false; }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
