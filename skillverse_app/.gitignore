# Linux/Windows ephemeral
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# Firebase — keep google-services.json / GoogleService-Info.plist committed
# for this project since builds rely on them, but ignore the CLI's own
# local cache/config if present.
.firebase/
